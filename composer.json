{
    "name": "xuwenxiong/rector-phalcon",
    "type": "rector-extension",
    "license": "MIT",
    "description": "Rector upgrade rules for Phalcon Framework",
    "authors": [
        {
            "name": "xuwenxiong",
            "homepage": "https://github.com/xuwenxiong"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-xml": "*"
    },
    "require-dev": {
        "phalcon/ide-stubs": "^5.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "RectorPhalcon\\": "src"
        },
        "exclude-from-classmap": [
            "/src/*/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RectorPhalcon\\Phalcon4\\Tests\\": "src/Phalcon4/Tests",
            "RectorPhalcon\\Phalcon5\\Tests\\": "src/Phalcon5/Tests",
            "RectorPhalcon\\Set\\Tests\\": "src/Set/Tests",
            "RectorPhalcon\\Support\\Tests\\": "src/Support/Tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
