{
    "name": "xuwenxiong/rector-phalcon",
    "type": "rector-extension",
    "license": "MIT",
    "description": "Rector upgrade rules for Phalcon Framework",
    "authors": [
        {
            "name": "xuwenxiong",
            "homepage": "https://github.com/xuwenxiong"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-xml": "*"
    },
    "require-dev": {
        "phalcon/ide-stubs": "^5.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "RectorPhalcon\\": "src"
        },
        "exclude-from-classmap": [
            "/src/*/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RectorPhalcon\\Phalcon5\\Tests\\": "src/Phalcon5/Tests"
        }
    },
    "extra": {
        "rector": {
            "includes": [
                "src/Phalcon5/Config/Set/phalcon50.php"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "rector/extension-installer": true
        }
    }
}
